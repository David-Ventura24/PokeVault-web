# ============================================================
# Backend de PokéVault — plantilla de variables de entorno
# Copiar a `.env` (ignorada por git) y completar.
# SOLO PLACEHOLDERS: no escribir secretos reales aquí ni subir un
# `.env` con credenciales; cada quien usa las de su máquina.
# ============================================================

# --- Puerto del API ---
# El frontend lo refleja en `sitio/js/config.js` → CONFIG.URL_BASE (p. ej. http://localhost:4000).
# Cualquier cambio aquí se avisa al equipo del front.
PORT=4000

# --- Prefijo externo si va detrás de un proxy inverso (opcional) ---
PUBLIC_URL=

# --- Base de datos ---
# Motor a elección del equipo (PostgreSQL, MySQL, SQLite...). Esquema solo con
# migraciones versionadas en src/db/migrations/.
DATABASE_URL=postgres://USUARIO:CONTRASENA@localhost:5432/pokevault
DATABASE_POOL_MAX=10

# --- Semilla de desarrollo (usuarios y productos de prueba) ---
# En producción: false.
DB_SEED_ENABLED=true

# --- Autenticación ---
# Secreto para firmar los JWT. Generar con `openssl rand -hex 32`; no usar este
# valor de ejemplo ni reutilizarlo entre ambientes.
JWT_SECRET=REEMPLAZAR_POR_SECRETO_ALEATORIO_32_BYTES
JWT_ALG=HS256
# El frontend no renueva tokens: si la vida es muy corta se pierde la sesión a
# mitad de una compra. 12h es cómodo para el curso.
JWT_EXPIRES_IN=12h

# --- Contraseñas e intentos de acceso ---
# A propósito sin endurecer: la definición del proyecto (§4) exige al menos una
# vulnerabilidad a nivel de código y una a nivel de servidor, documentadas y
# explotables. Leer backend/README.md, sección 5, antes de cambiar esto.
# Si el equipo elige «fuerza bruta» como vulnerabilidad de código, LOGIN_MAX_INTENTOS
# se queda en 0 (sin límite) y PASSWORD_HASHER en el algoritmo débil que acuerden.
PASSWORD_HASHER=sha256
LOGIN_MAX_INTENTOS=0
PASSWORD_MIN_LENGTH=6

# --- Subida de imágenes (POST /archivos, campo `archivo`) ---
# Directorio físico; debe respaldarse y servirse como estático.
UPLOAD_DIR=./storage/uploads
# Base pública de esas URLs, sin barra final: http://localhost:4000/uploads
UPLOAD_PUBLIC_BASE_URL=
# 0 = sin límite de tamaño, y MIME vacío = sin lista blanca. Tampoco es un descuido:
# validar aquí cerraría el vector que la entrega pide dejar abierto (ver sección 5).
UPLOAD_MAX_BYTES=0
UPLOAD_ALLOWED_MIME=

# --- CORS (orígenes del frontend, separados por coma) ---
# En desarrollo el front es estático: `node servidor-local.mjs` lo sirve en :4173.
# En el laboratorio va el origen real de Nginx/Apache.
CORS_ORIGIN=http://localhost:4173
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type,Accept
CORS_MAX_AGE=86400

# --- Reglas de negocio (deben coincidir con frontend/src/lib/factura.ts, que el front
#     ejecuta compilado en sitio/js/factura.js) ---
MONEDA=USD
IVA_PORCENTAJE=13
ENVIO_USD=9
ENVIO_GRATIS_DESDE_USD=250
# Ventana de reserva de la factura: vence = fecha + esto.
RESERVA_HORAS=72
# Folios PV-YYYY-NNNN, consecutivos por año civil.
FOLIO_PREFIJO=PV
FOLIO_LONGITUD_NUMERO=4
# Códigos promocionales: codigo:porcentaje, separados por coma.
PROMOCIONES=BOVEDA10:10,ESTUDIANTE5:5,PIEZA1:15

# --- Correo (avisos de factura y recuperación de contraseña) ---
# No hay pasarela de pago: el correo no cobra nada, solo informa.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USUARIO=
SMTP_CONTRASENA=
MAIL_DE_REMITE=PokeVault <no-reply@pokevault.com>
MAIL_FACTURAS=facturas@pokevault.com

# --- Cuenta de depósito (texto del documento, no es un secreto) ---
BANCO_NOMBRE=Banco Cuscatlan
BANCO_TIPO=Cuenta corriente monetaria (USD)
# El número real de cuenta va solo en el entorno desplegado.
BANCO_NUMERO=

# --- Observabilidad ---
# Nunca loguear cuerpos de /auth ni datos fiscales completos.
LOG_LEVEL=info
TZ=UTC
